# Set ONE of these to use a real LLM. With none set, the offline demo extractor is used.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: force a provider when several keys are set (anthropic | openai | gemini)
EXTRACTION_PROVIDER=

# Optional model overrides
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-2.5-flash

PORT=3000
